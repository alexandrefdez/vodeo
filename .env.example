# Vodeo: variables de entorno
# Copia este archivo como .env y completa los valores obligatorios.

# Obligatorias

# Clave de firma de los JWT. Debe estar codificada en Base64 y tener al menos 32 bytes.
# Linux/macOS: openssl rand -base64 48
# Windows: powershell -Command "[Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))"
JWT_SECRET=

# API keys para la importación de metadatos (gratuitas).
# TMDB: https://www.themoviedb.org/settings/api
# OMDb: https://www.omdbapi.com/apikey.aspx
TMDB_API_KEY=
OMDB_API_KEY=

# Opcionales
# Se muestran con su valor por defecto, pensado solo para desarrollo local.

# Credenciales de PostgreSQL.
# DB_USER=root
# DB_PASSWORD=rootpassword

# Contraseña del administrador (admin@vodeo.com), creado en el primer arranque.
# VODEO_ADMIN_PASSWORD=admin1234